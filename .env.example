# Model + sandbox credentials for `uv run eval`. Copy to `.env`, fill in, then run with
#   uv run --env-file .env eval <taskset-id> ...
#
# Prime Intellect: one key covers inference (api.pinference.ai, the default client)
# and remote sandboxes (the default runtime). `prime login` also works instead of these.
PRIME_API_KEY=
PRIME_TEAM_ID=

# Any OpenAI-compatible endpoint instead of Prime inference, selected per run with
#   --client.base-url https://api.openai.com/v1 --client.api-key-var OPENAI_API_KEY
OPENAI_API_KEY=
